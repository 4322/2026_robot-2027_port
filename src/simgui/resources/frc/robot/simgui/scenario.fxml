<?xml version="1.0" encoding="UTF-8"?>

<!--
  Scenario tab: settings card on top, field preview on the left, event table + event form on the
  right. The field canvas and the event form are added by ScenarioController into fieldHolder and
  editorHolder.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import frc.robot.simgui.DoubleSpinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="frc.robot.simgui.ScenarioController">
  <padding><Insets top="8" right="8" bottom="0" left="8"/></padding>

  <!-- ===== scenario settings ===== -->
  <top>
    <VBox styleClass="card" spacing="8">
      <BorderPane.margin><Insets bottom="8"/></BorderPane.margin>
      <GridPane hgap="8" vgap="8">
        <columnConstraints>
          <ColumnConstraints/>
          <ColumnConstraints prefWidth="240"/>
          <ColumnConstraints/>
          <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Description" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="description" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
      </GridPane>
      <HBox spacing="10" alignment="CENTER_LEFT">
        <CheckBox fx:id="hasAuto" text="Auto"/>
        <ComboBox fx:id="autoRoutine" prefWidth="210"/>
        <Label text="min duration (s)"/>
        <DoubleSpinner fx:id="autoDuration" min="0" max="600" initialValue="20" step="1" prefWidth="90"/>
        <Separator orientation="VERTICAL"/>
        <CheckBox fx:id="hasTeleop" text="Teleop"/>
        <Label text="start match time (s)"/>
        <DoubleSpinner fx:id="teleopMatchTime" min="0" max="600" initialValue="140" step="1" prefWidth="90"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Game data"/>
        <ComboBox fx:id="gameData" prefWidth="70"/>
        <CheckBox fx:id="debugBindings" text="Log button edges (Sim/Debug)"/>
      </HBox>
    </VBox>
  </top>

  <center>
    <SplitPane dividerPositions="0.56">
      <!-- ===== field preview ===== -->
      <BorderPane>
        <top>
          <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets bottom="6"/></padding>
            <ToggleButton fx:id="previewRed" text="Preview as RED" styleClass="red-preview" minWidth="-Infinity">
              <tooltip><Tooltip text="Show the scenario as it runs on the RED alliance (poses mirrored)"/></tooltip>
            </ToggleButton>
            <Label styleClass="hint" wrapText="true"
                   text="Green: setPose · Teal: named location (edit in Field Locations) · Blue arrows: drive stick · Purple: pose expects · Dashed: estimated path"/>
          </HBox>
        </top>
        <center>
          <StackPane fx:id="fieldHolder"/>
        </center>
      </BorderPane>

      <!-- ===== events ===== -->
      <SplitPane orientation="VERTICAL" dividerPositions="0.55">
        <VBox spacing="6">
          <padding><Insets left="6"/></padding>
          <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Segment"/>
            <ChoiceBox fx:id="segmentChoice"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="segmentInfo" styleClass="hint"/>
          </HBox>
          <TableView fx:id="table" editable="true" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
              <TableColumn fx:id="colIndex" text="#" prefWidth="36" sortable="false"/>
              <TableColumn fx:id="colTime" text="Time" prefWidth="58" sortable="false"/>
              <TableColumn fx:id="colWait" text="Wait" prefWidth="54" sortable="false"/>
              <TableColumn fx:id="colType" text="Type" prefWidth="95" sortable="false"/>
              <TableColumn fx:id="colDetails" text="Details" prefWidth="190" sortable="false"/>
              <TableColumn fx:id="colLabel" text="Label" prefWidth="170" sortable="false"/>
            </columns>
            <placeholder><Label text="No events. Use “Add event”."/></placeholder>
          </TableView>
          <HBox spacing="4">
            <MenuButton fx:id="addMenu" text="Add event" styleClass="primary"/>
            <Button text="Duplicate" onAction="#duplicateEvent"/>
            <Button text="Delete" styleClass="danger" onAction="#deleteEvent"/>
            <Button text="▲" styleClass="icon" onAction="#moveUp">
              <tooltip><Tooltip text="Move up"/></tooltip>
            </Button>
            <Button text="▼" styleClass="icon" onAction="#moveDown">
              <tooltip><Tooltip text="Move down"/></tooltip>
            </Button>
          </HBox>
        </VBox>
        <ScrollPane fitToWidth="true">
          <VBox fx:id="editorHolder">
            <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
          </VBox>
        </ScrollPane>
      </SplitPane>
    </SplitPane>
  </center>

  <bottom>
    <HBox spacing="8" alignment="CENTER_LEFT">
      <padding><Insets top="6" bottom="6"/></padding>
      <Label fx:id="status" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
      <Button fx:id="revertButton" text="Revert" onAction="#revert"/>
      <Button fx:id="saveButton" text="Save" styleClass="primary" onAction="#save"/>
    </HBox>
  </bottom>
</BorderPane>
