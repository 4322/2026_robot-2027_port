<?xml version="1.0" encoding="UTF-8"?>

<!-- Field Locations tab: drag named poses on the field (left), edit them in the table (right). -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import frc.robot.simgui.DoubleSpinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="frc.robot.simgui.LocationsController">
  <padding><Insets top="8" right="8" bottom="0" left="8"/></padding>
  <center>
    <SplitPane dividerPositions="0.68">
      <BorderPane>
        <top>
          <Label styleClass="hint" wrapText="true">
            <padding><Insets bottom="6"/></padding>
            <text>Poses are in BLUE field coordinates; scenarios mirror them for RED unless the event says "absolute". Drag a robot to move it, drag its dot to rotate.</text>
          </Label>
        </top>
        <center>
          <StackPane fx:id="fieldHolder"/>
        </center>
      </BorderPane>

      <VBox spacing="6">
        <padding><Insets left="6"/></padding>
        <Label text="NAMED LOCATIONS" styleClass="section-title"/>
        <TableView fx:id="table" editable="true" VBox.vgrow="ALWAYS">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
          <columns>
            <TableColumn fx:id="colName" text="Name" prefWidth="200" sortable="false"/>
            <TableColumn fx:id="colX" text="x (m)" prefWidth="62" sortable="false"/>
            <TableColumn fx:id="colY" text="y (m)" prefWidth="62" sortable="false"/>
            <TableColumn fx:id="colDeg" text="deg" prefWidth="56" sortable="false"/>
            <TableColumn fx:id="colUsed" text="Used by" prefWidth="60" sortable="false"/>
          </columns>
        </TableView>
        <HBox spacing="4">
          <Button text="Add" styleClass="primary" onAction="#add"/>
          <Button text="Rename…" onAction="#rename"/>
          <Button text="Delete" styleClass="danger" onAction="#delete"/>
        </HBox>
        <VBox styleClass="card" spacing="6">
          <Label text="PATH PREVIEW (editor only)" styleClass="section-title"/>
          <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Full-stick speed (m/s)"/>
            <DoubleSpinner fx:id="maxSpeed" min="0.1" max="10" initialValue="4.5" step="0.1" prefWidth="90"/>
          </HBox>
          <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Full-stick turn (deg/s)"/>
            <DoubleSpinner fx:id="maxTurn" min="10" max="1440" initialValue="360" step="10" prefWidth="90"/>
          </HBox>
        </VBox>
      </VBox>
    </SplitPane>
  </center>
  <bottom>
    <HBox spacing="8" alignment="CENTER_LEFT">
      <padding><Insets top="6" bottom="6"/></padding>
      <Label fx:id="status" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
      <Button text="Save field-locations.json" styleClass="primary" onAction="#save"/>
    </HBox>
  </bottom>
</BorderPane>
