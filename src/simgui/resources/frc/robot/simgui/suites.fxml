<?xml version="1.0" encoding="UTF-8"?>

<!-- Suites tab: suite files on the left, the selected suite's runs on the right. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="frc.robot.simgui.SuitesController">
  <padding><Insets top="8" right="8" bottom="0" left="8"/></padding>
  <center>
    <SplitPane dividerPositions="0.2">
      <VBox spacing="6" minWidth="160">
        <Label text="SUITES" styleClass="section-title"/>
        <ListView fx:id="suiteList" VBox.vgrow="ALWAYS"/>
        <HBox spacing="4">
          <Button text="New…" onAction="#newSuite" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
          <Button text="Delete" styleClass="danger" onAction="#deleteSuite" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>
      </VBox>

      <VBox spacing="6">
        <padding><Insets left="6"/></padding>
        <HBox spacing="8" alignment="CENTER_LEFT">
          <Label text="Name"/>
          <TextField fx:id="name" prefColumnCount="28"/>
        </HBox>
        <TableView fx:id="table" editable="true" VBox.vgrow="ALWAYS">
          <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
          <columns>
            <TableColumn fx:id="colScenario" text="Scenario" prefWidth="300" sortable="false"/>
            <TableColumn fx:id="colBlue" text="BLUE" prefWidth="70" sortable="false"/>
            <TableColumn fx:id="colRed" text="RED" prefWidth="70" sortable="false"/>
            <TableColumn fx:id="colDuration" text="Auto duration (all autos)" prefWidth="180" sortable="false"/>
          </columns>
          <placeholder><Label text="Select a suite, then use “Add run”."/></placeholder>
        </TableView>
        <HBox spacing="4" alignment="CENTER_LEFT">
          <Button text="Add run" styleClass="primary" onAction="#addRun"/>
          <Button text="Remove" styleClass="danger" onAction="#removeRun"/>
          <Button text="▲" styleClass="icon" onAction="#moveUp"/>
          <Button text="▼" styleClass="icon" onAction="#moveDown"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Button text="Save suite" styleClass="primary" onAction="#save"/>
        </HBox>
      </VBox>
    </SplitPane>
  </center>
  <bottom>
    <Label styleClass="hint" wrapText="true">
      <padding><Insets top="6" bottom="6"/></padding>
      <text>Runs execute top to bottom; each ticked alliance runs as its own test. "(all autos)" runs every auto except the DRIVE_* characterization routines.</text>
    </Label>
  </bottom>
</BorderPane>
