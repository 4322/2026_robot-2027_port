{
  "name": "Intake Test",
  "description": "Deploy, eject, smoosh, intake, re-home, then repeat.",
  "teleop": {
    "events": [
      { "wait": 0.1, "type": "setPose", "location": "AllianceZoneTestSpot", "label": "Start pose" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "hold", "label": "Deploy/Intake" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "release", "label": "Deploy/Intake Release" },
      { "wait": 0, "type": "expect", "probe": "intake.extended", "equals": "true", "within": 1, "label": "Intake extended after deploy" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "hold", "label": "IntakeOff" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "release", "label": "IntakeOff Release" },
      { "wait": 0.5, "type": "button", "button": "X", "action": "hold", "label": "Start ejecting" },
      { "wait": 0, "type": "expect", "probe": "intake.state", "equals": "EJECT", "within": 0.5, "label": "Ejecting" },
      { "wait": 2, "type": "button", "button": "X", "action": "release", "label": "Stop ejecting" },
      { "wait": 0.5, "type": "button", "button": "Y", "action": "hold", "label": "Start smooshing" },
      { "wait": 0, "type": "expect", "probe": "intake.state", "equals": "SMOOSH", "within": 0.5, "label": "Smooshing" },
      { "wait": 2, "type": "button", "button": "Y", "action": "release", "label": "Stop smooshing" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "hold", "label": "Start intaking" },
      { "wait": 0, "type": "expect", "probe": "intake.state", "equals": "INTAKING", "within": 0.5, "label": "Intaking" },
      { "wait": 0.5, "type": "button", "button": "X", "action": "hold", "label": "Start ejecting while intaking" },
      { "wait": 2, "type": "button", "button": "X", "action": "release", "label": "Stop ejecting" },
      { "wait": 0.5, "type": "button", "button": "Y", "action": "hold", "label": "Start smooshing while intaking" },
      { "wait": 2, "type": "button", "button": "Y", "action": "release", "label": "Stop smooshing" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "release", "label": "Stop intaking" },
      { "wait": 0.5, "type": "button", "button": "A", "action": "press", "label": "Re-home Intake" },
      { "wait": 2, "type": "button", "button": "LEFT_BUMPER", "action": "hold", "label": "Deploy/Intake" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "release", "label": "Deploy/Intake Release" },
      { "wait": 0, "type": "expect", "probe": "intake.extended", "equals": "true", "within": 1, "label": "Intake extended after deploy" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "hold", "label": "IntakeOff" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "release", "label": "IntakeOff Release" },
      { "wait": 0.5, "type": "button", "button": "X", "action": "hold", "label": "Start ejecting" },
      { "wait": 2, "type": "button", "button": "X", "action": "release", "label": "Stop ejecting" },
      { "wait": 0.5, "type": "button", "button": "Y", "action": "hold", "label": "Start smooshing" },
      { "wait": 2, "type": "button", "button": "Y", "action": "release", "label": "Stop smooshing" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "hold", "label": "Start intaking" },
      { "wait": 0.5, "type": "button", "button": "X", "action": "hold", "label": "Start ejecting while intaking" },
      { "wait": 2, "type": "button", "button": "X", "action": "release", "label": "Stop ejecting" },
      { "wait": 0.5, "type": "button", "button": "Y", "action": "hold", "label": "Start smooshing while intaking" },
      { "wait": 2, "type": "button", "button": "Y", "action": "release", "label": "Stop smooshing" },
      { "wait": 0.5, "type": "button", "button": "LEFT_BUMPER", "action": "release", "label": "Stop intaking" },
      { "wait": 0.1, "type": "end", "label": "End" }
    ]
  }
}
